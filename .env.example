# EventPilot AI - Web App Environment Configuration Template
# Copy this file to .env.local for local development or set in Vercel project settings.
# NEVER commit your actual .env.local file to version control.

# -----------------------------------------------------------------------------
# Supabase Configuration (Mandatory for production, optional for Demo mode)
# Supabase Dashboard -> Project Settings -> API Keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_key_here

# -----------------------------------------------------------------------------
# Server-Side Privileged Operations (Optional / Production)
# -----------------------------------------------------------------------------
# Service Role key for elevated backend operations (push notifications, audit logs)
SUPABASE_SECRET_KEY=

# Secret token required to trigger the 10-minute discovery scan via HTTP endpoint
# Set a strong random string (e.g. openssl rand -hex 32)
CRON_SECRET=

# GitHub dispatch token if triggering worker through GitHub Actions workflow_dispatch
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# -----------------------------------------------------------------------------
# Web Push (VAPID) Settings (RFC 8291 Web Push)
# Generate with: npx web-push generate-vapid-keys
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yourdomain.com
