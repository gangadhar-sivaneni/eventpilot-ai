# Worker settings (copy to worker/.env). NEVER commit the real file: the secret key bypasses all security.
# Supabase dashboard → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
# Only for the live RLS test (RLS_TEST=1 pytest -m live)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Email alerts (optional): a Gmail account with 2-Step Verification + an App Password
GMAIL_USER=
GMAIL_APP_PASSWORD=
SITE_URL=http://localhost:3000

# Registration agent (runs on your computer)
ENABLE_SUBMIT=false            # keep false until you have tested on a form you control
BROWSER_CHANNEL=               # "chrome" to use installed Google Chrome instead of bundled Chromium
BROWSER_PROFILE_DIR=           # default: worker/.browser-profile (keeps your Google sign-in between runs)
